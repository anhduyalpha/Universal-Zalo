# ==============================================================================
# Dockerfile cho Gateway Hub (Node.js / TypeScript WebSocket Server)
# ==============================================================================
FROM node:20-alpine AS builder

WORKDIR /app

COPY services/gateway-hub/package.json ./
COPY services/gateway-hub/tsconfig.json ./

RUN npm install

COPY services/gateway-hub/src ./src

RUN npm run build

# Production Runner
FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production

COPY services/gateway-hub/package.json ./
RUN npm install --only=production

COPY --from=builder /app/dist ./dist

EXPOSE 8080

CMD ["node", "dist/index.js"]
