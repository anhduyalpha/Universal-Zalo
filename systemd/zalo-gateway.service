[Unit]
Description=Universal Zalo Gateway Hub (Node.js WebSocket Hub)
After=network.target redis.service postgresql.service zalo-proxy.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/universal-zalo/services/gateway-hub
ExecStart=/usr/bin/node dist/index.js
Restart=always
RestartSec=3
Environment=NODE_ENV=production
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
